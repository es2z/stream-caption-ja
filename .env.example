# .env にコピーして使う(.env は git に含めない)

# OBS の「ツール → WebSocket サーバー設定」のパスワード
OBS_PASSWORD=

# OBS が動いている Windows のアドレス
#   Docker Desktop(WSL2 バックエンド)なら host.docker.internal のままでよい
#   WSL 内に直接入れた Docker Engine の場合は README の「ネットワーク」を参照
OBS_HOST=host.docker.internal
OBS_PORT=4455

# 字幕モード(config.yaml の mode より優先): en | ja
# CAPTION_MODE=en

# YouTube の字幕取り込み URL(日本語字幕を出す場合)。配信キーと同じく他人に見せないこと
# YOUTUBE_ENABLED=true
# YOUTUBE_CAPTION_URL=http://upload.youtube.com/closedcaption?cid=...

# 翻訳モデル(PLaMo 3 Translate)。日英では 0.8B と 2B の差が小さいので 0.8B を標準にしている
# 2B にする場合: pfnet/plamo-3-translate-2b-GGUF:Q4_K_M
PLAMO_MODEL=pfnet/plamo-3-translate-0.8b-GGUF:Q4_K_M

# Hugging Face でモデルの利用規約への同意が必要な場合のみ設定
# HF_TOKEN=

# GPU なしで配線だけ確認したいとき: dummy
# ASR_BACKEND=haas
